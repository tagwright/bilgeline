# Destination secrets for the COLLECTOR container. These are the environment
# variables the collector expands from the ${env:VAR} references bilgeline
# emits into the generated config. bilgeline itself never reads this file and
# holds none of these values.
#
# Copy this to collector.env and fill in real values, OR generate collector.env
# at deploy time from a SOPS-encrypted source (see docs/DEPLOY.md). Do NOT commit
# the filled-in collector.env.
#
# The variable names here are examples matching bilgeline.example.yml. Yours are
# whatever ${env:VAR} names your own destinations reference; `bilgeline generate`
# prints the config so you can see exactly which vars the collector will need.

# Bearer token for the "loki" destination in bilgeline.example.yml.
LOKI_BEARER=replace-me
